<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="News.NewsPages.SignUp"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource BgColor}"
             Title="SignUp"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- HEADER -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,Auto,Auto"
                  HorizontalOptions="Center"
                  Margin="0,30,0,10">

                <Image Source="nw.png"
                       Grid.Column="0"
                       HeightRequest="110"/>

                <Label Grid.Column="1"
                       Text="News"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       FontSize="32"
                       Margin="-10,0,0,0"
                       TextColor="{StaticResource News}"/>

                <Label Grid.Column="2"
                       Text="Watch"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       FontSize="32"
                       TextColor="{StaticResource Watch}"/>
            </Grid>

            <!-- FORM CARD -->
            <Frame Grid.Row="1"
                   Margin="20,10"
                   CornerRadius="25"
                   BackgroundColor="White"
                   HasShadow="True">

                <Frame.Shadow>
                    <Shadow Brush="#30000000" Offset="0,8" Radius="15"/>
                </Frame.Shadow>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      Padding="20"
                      RowSpacing="12">

                    <!-- USERNAME -->
                    <Label Text="Username" TextColor="#555"/>
                    <Frame Grid.Row="1" CornerRadius="15" Padding="10"
                           BackgroundColor="#F5F7FB" BorderColor="Transparent">
                        <Entry x:Name="name"
                            Placeholder="Enter username"
                               TextColor="Black"
                               BackgroundColor="Transparent"/>
                    </Frame>

                    <!-- EMAIL -->
                    <Label Grid.Row="2" Text="Email" TextColor="#555"/>
                    <Frame Grid.Row="3" CornerRadius="15" Padding="10"
                           BackgroundColor="#F5F7FB">
                        <Entry Placeholder="Enter email"
                               x:Name="email"
                               Keyboard="Email"
                               TextColor="Black"
                               BackgroundColor="Transparent"/>
                    </Frame>

                    <!-- PHONE -->
                    <Label Grid.Row="4" Text="Phone" TextColor="#555"/>
                    <Frame Grid.Row="5" CornerRadius="15" Padding="10"
                           BackgroundColor="#F5F7FB">
                        <Entry Text="+91 "
                               x:Name="phone"
                               Keyboard="Telephone"
                               TextColor="Black"
                               BackgroundColor="Transparent"/>
                    </Frame>

                    <!-- PASSWORD -->
                    <Label Grid.Row="6" Text="Password" TextColor="#555"/>
                    <Frame Grid.Row="7" CornerRadius="15" Padding="10"
                           BackgroundColor="#F5F7FB">
                        <Entry Placeholder="Enter password"
                               x:Name="password"
                               IsPassword="True"
                               TextColor="Black"
                               BackgroundColor="Transparent"/>
                    </Frame>

                    <!-- I AM -->
                    <Label Grid.Row="8"
                           Text="I am a"
                           FontSize="18"
                           FontAttributes="Bold"
                           Margin="0,10,0,0"
                           TextColor="Black"/>

                    <!-- RADIO BUTTON -->
                    <HorizontalStackLayout Grid.Row="9" Spacing="20">
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="20">
                        <Frame CornerRadius="20"
                               Padding="8"
                               BackgroundColor="#F5F7FB">
                            <RadioButton Content="Media Reporter"
                                         GroupName="UserType"
                                         TextColor="Black"/>
                        </Frame>

                        <Frame Grid.Column="1"
                               CornerRadius="20"
                               Padding="5"
                               BackgroundColor="#F5F7FB"
                               >
                            <RadioButton WidthRequest="110"
                                Content="Visitor"
                                         GroupName="UserType"
                                         TextColor="Black"/>
                        </Frame>
                        </Grid>
                    </HorizontalStackLayout>

                    <!-- SIGN UP BUTTON -->
                    <Button Grid.Row="10"
                            Text="Create Account"
                            FontSize="18"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="30"
                            Margin="0,15,0,0"
                            TextColor="White"
                            Clicked="Sign_In">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#005A99" Offset="0.0"/>
                                <!-- darker -->
                                <GradientStop Color="#007BC0" Offset="0.5"/>
                                <!-- main color -->
                                <GradientStop Color="#33A1E0" Offset="1.0"/>
                                <!-- lighter -->
                            </LinearGradientBrush>
                        </Button.Background>

                        <Button.Shadow>
                            <Shadow Brush="#40000000"
                                    Offset="0,6"
                                    Radius="10"/>
                        </Button.Shadow>

                    </Button>

                </Grid>
            </Frame>

            <!-- FOOTER -->
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" VerticalOptions="End">

                <VerticalStackLayout Spacing="25" Padding="20">

                    <!-- OR -->
                    <Grid ColumnDefinitions="*,Auto,*">
                        <BoxView HeightRequest="1" BackgroundColor="#DDD"/>
                        <Label Grid.Column="1"
                               Text="or sign in with"
                               Margin="10,0"
                               FontSize="13"
                               TextColor="Gray"/>
                        <BoxView Grid.Column="2"
                                 HeightRequest="1"
                                 BackgroundColor="#DDD"/>
                    </Grid>

                    <!-- SOCIAL -->
                    <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">

                        <!-- reusable style -->
                        <Frame WidthRequest="55" HeightRequest="55"
                               CornerRadius="15"
                               BackgroundColor="White"
                               HasShadow="True">
                            <Image Source="email.png"/>
                        </Frame>

                        <Frame WidthRequest="55" HeightRequest="55"
                               CornerRadius="15"
                               BackgroundColor="White"
                               HasShadow="True">
                            <Image Source="google.png"/>
                        </Frame>

                        <Frame WidthRequest="55" HeightRequest="55"
                               CornerRadius="15"
                               BackgroundColor="White"
                               HasShadow="True">
                            <Image Source="facebook.png"/>
                        </Frame>

                        <Frame WidthRequest="55" HeightRequest="55"
                               CornerRadius="15"
                               BackgroundColor="White"
                               HasShadow="True">
                            <Image Source="twitter.png"/>
                        </Frame>

                        <Frame WidthRequest="55" HeightRequest="55"
                               CornerRadius="15"
                               BackgroundColor="White"
                               HasShadow="True">
                            <Image Source="apple.png"/>
                        </Frame>

                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- TERMS -->
                <Label Grid.Row="1"
                       HorizontalTextAlignment="Center"
                       FontSize="12"
                       Margin="0,0,0,10"
                       TextColor="Gray">

                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="By signing up you accept our "/>
                            <Span Text="Terms and Conditions"
                                  FontAttributes="Bold"
                                  TextColor="#4facfe"/>
                        </FormattedString>
                    </Label.FormattedText>

                </Label>

            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>