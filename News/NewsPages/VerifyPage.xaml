<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="News.NewsPages.VerifyPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource BgColor}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- HEADER -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,Auto,Auto"
                  HorizontalOptions="Center"
                  Margin="0,30,0,10">

                <Image Source="nw.png"
                       Grid.Column="0"
                       HeightRequest="110"/>

                <Label Grid.Column="1"
                       Text="News"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       FontSize="32"
                       Margin="-10,0,0,0"
                       TextColor="{StaticResource News}"/>

                <Label Grid.Column="2"
                       Text="Watch"
                       FontAttributes="Bold"
                       VerticalTextAlignment="Center"
                       FontSize="32"
                       TextColor="{StaticResource Watch}"/>
            </Grid>

            <!-- CARD -->
            <Frame Grid.Row="1"
                   Margin="20,10"
                   CornerRadius="25"
                   BackgroundColor="White"
                   HasShadow="True">

                <Frame.Shadow>
                    <Shadow Brush="#30000000" Offset="0,8" Radius="15"/>
                </Frame.Shadow>

                <Grid Padding="20"
                      RowSpacing="12"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                    <!-- EMAIL -->
                    <Label Text="Email" TextColor="#555"/>
                    <Frame Grid.Row="1"
                           CornerRadius="15"
                           Padding="10"
                           BackgroundColor="#F5F7FB">
                        <Entry Placeholder="Enter email"
                               Keyboard="Email"
                               TextColor="Black"
                               BackgroundColor="Transparent"/>
                    </Frame>

                    <!-- CODE -->
                    <Label Grid.Row="2"
                           Text="Verification Code"
                           TextColor="#555"/>
                    <Frame Grid.Row="3"
                           CornerRadius="15"
                           Padding="10"
                           BackgroundColor="#F5F7FB">
                        <Entry Placeholder="Enter code"
                               TextColor="Black"
                               BackgroundColor="Transparent"/>
                    </Frame>

                    <!-- NEW PASSWORD -->
                    <Label Grid.Row="4"
                           Text="New Password"
                           TextColor="#555"/>
                    <Frame Grid.Row="5"
                           CornerRadius="15"
                           Padding="10"
                           BackgroundColor="#F5F7FB">
                        <Entry Placeholder="New password"
                               IsPassword="True"
                               TextColor="Black"
                               BackgroundColor="Transparent"/>
                    </Frame>

                    <!-- CONFIRM PASSWORD -->
                    <Label Grid.Row="6"
                           Text="Confirm Password"
                           TextColor="#555"/>
                    <Frame Grid.Row="7"
                           CornerRadius="15"
                           Padding="10"
                           BackgroundColor="#F5F7FB">
                        <Entry Placeholder="Re-enter password"
                               IsPassword="True"
                               TextColor="Black"
                               BackgroundColor="Transparent"/>
                    </Frame>

                    <!-- BUTTON -->
                    <Button Grid.Row="8"
                            Text="Verify and Continue"
                            FontSize="18"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="30"
                            Margin="0,15,0,0"
                            TextColor="White"
                            Clicked="City">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#005A99" Offset="0.0"/>
                                <GradientStop Color="#007BC0" Offset="0.5"/>
                                <GradientStop Color="#33A1E0" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Button.Background>

                        <Button.Shadow>
                            <Shadow Brush="#40000000"
                                    Offset="0,6"
                                    Radius="10"/>
                        </Button.Shadow>
                    </Button>

                </Grid>
            </Frame>

            <!-- FOOTER -->
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" VerticalOptions="End">

                <VerticalStackLayout Spacing="25" Padding="20">

                    <Grid ColumnDefinitions="*,Auto,*">
                        <BoxView HeightRequest="1" BackgroundColor="#DDD"/>
                        <Label Grid.Column="1"
                               Text="secure verification"
                               Margin="10,0"
                               FontSize="13"
                               TextColor="Gray"/>
                        <BoxView Grid.Column="2"
                                 HeightRequest="1"
                                 BackgroundColor="#DDD"/>
                    </Grid>

                </VerticalStackLayout>

                <Label Grid.Row="1"
                       HorizontalTextAlignment="Center"
                       FontSize="12"
                       Margin="0,0,0,10"
                       TextColor="Gray"
                       Text="We protect your data securely"/>

            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>