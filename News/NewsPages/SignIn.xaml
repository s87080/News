<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="News.NewsPages.SignIn"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource BgColor}"
             Title="SignIn"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- HEADER -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,Auto,Auto"
                  HorizontalOptions="Center"
                  Margin="0,30,0,10">

                <Image Source="nw.png"
                       Grid.Column="0"
                       HeightRequest="110"/>

                <Label Grid.Column="1"
                       Text="News"
                       VerticalTextAlignment="Center"
                       FontAttributes="Bold"
                       FontSize="32"
                       Margin="-10,0,0,0"
                       TextColor="{StaticResource News}"/>

                <Label Grid.Column="2"
                       Text="Watch"
                       VerticalTextAlignment="Center"
                       FontAttributes="Bold"
                       FontSize="32"
                       TextColor="{StaticResource Watch}"/>
            </Grid>

            <!-- FORM CARD -->
            <Frame Grid.Row="1"
                   Margin="20,10"
                   CornerRadius="25"
                   BackgroundColor="White"
                   HasShadow="True">

                <Frame.Shadow>
                    <Shadow Brush="#30000000"
                            Offset="0,8"
                            Radius="15"/>
                </Frame.Shadow>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      Padding="20"
                      RowSpacing="12">

                    <!-- USERNAME -->
                    <Label Text="Username" TextColor="#555"/>
                    <Frame Grid.Row="1"
                           CornerRadius="15"
                           Padding="10"
                           BackgroundColor="#F5F7FB">
                        <Entry Placeholder="Enter username"
                               TextColor="Black"
                               BackgroundColor="Transparent"
                               x:Name="USERNAME"/>
                    </Frame>

                    <!-- EMAIL -->
                    <Label Grid.Row="2"
                           Text="Email"
                           TextColor="#555"/>
                    <Frame Grid.Row="3"
                           CornerRadius="15"
                           Padding="10"
                           BackgroundColor="#F5F7FB">
                        <Entry Placeholder="Enter email"
                               Keyboard="Email"
                               TextColor="Black"
                               BackgroundColor="Transparent"
                               x:Name="EMAIL"/>
                    </Frame>

                    <!-- PASSWORD -->
                    <Label Grid.Row="4"
                           Text="Password"
                           TextColor="#555"/>
                    <Frame Grid.Row="5"
                           CornerRadius="15"
                           Padding="10"
                           BackgroundColor="#F5F7FB">
                        <Entry Placeholder="Enter password"
                               IsPassword="True"
                               TextColor="Black"
                               BackgroundColor="Transparent"
                               x:Name="PASSWORD"/>
                    </Frame>

                    <!-- FORGET PASSWORD -->
                    <Button Grid.Row="6"
                            Text="Forget Password ?"
                            HorizontalOptions="End"
                            BackgroundColor="Transparent"
                            TextColor="#4facfe"
                            FontAttributes="Bold"
                            Clicked="Forget_Button"/>

                    <!-- SIGN IN -->
                    <Button Grid.Row="7"
                            Text="Sign In"
                            FontSize="18"
                            FontAttributes="Bold"
                            HeightRequest="55"
                            CornerRadius="30"
                            Margin="0,10,0,10"
                            TextColor="White"
                            Clicked="SIGNIN">

                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#005A99" Offset="0.0"/>
                                <!-- darker -->
                                <GradientStop Color="#007BC0" Offset="0.5"/>
                                <!-- main color -->
                                <GradientStop Color="#33A1E0" Offset="1.0"/>
                                <!-- lighter -->
                            </LinearGradientBrush>
                        </Button.Background>

                        <Button.Shadow>
                            <Shadow Brush="#40000000"
                                    Offset="0,6"
                                    Radius="10"/>
                        </Button.Shadow>

                    </Button>

                </Grid>
            </Frame>

            <!-- FOOTER -->
            <Grid Grid.Row="2">

                <VerticalStackLayout Spacing="25" Padding="20">

                    <!-- OR -->
                    <Grid ColumnDefinitions="*,Auto,*">
                        <BoxView HeightRequest="1" BackgroundColor="#DDD"/>
                        <Label Grid.Column="1"
                               Text="or sign in with"
                               Margin="10,0"
                               FontSize="13"
                               TextColor="Gray"/>
                        <BoxView Grid.Column="2"
                                 HeightRequest="1"
                                 BackgroundColor="#DDD"/>
                    </Grid>

                    <!-- SOCIAL -->
                    <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">

                        <Frame WidthRequest="55" HeightRequest="55"
                               CornerRadius="15"
                               BackgroundColor="White"
                               HasShadow="True">
                            <Image Source="email.png"/>
                        </Frame>

                        <Frame WidthRequest="55" HeightRequest="55"
                               CornerRadius="15"
                               BackgroundColor="White"
                               HasShadow="True">
                            <Image Source="google.png"/>
                        </Frame>

                        <Frame WidthRequest="55" HeightRequest="55"
                               CornerRadius="15"
                               BackgroundColor="White"
                               HasShadow="True">
                            <Image Source="facebook.png"/>
                        </Frame>

                        <Frame WidthRequest="55" HeightRequest="55"
                               CornerRadius="15"
                               BackgroundColor="White"
                               HasShadow="True">
                            <Image Source="twitter.png"/>
                        </Frame>

                        <Frame WidthRequest="55" HeightRequest="55"
                               CornerRadius="15"
                               BackgroundColor="White"
                               HasShadow="True">
                            <Image Source="apple.png"/>
                        </Frame>

                    </HorizontalStackLayout>

                    <!-- REGISTER -->
                    <HorizontalStackLayout HorizontalOptions="Center">

                        <Label Text="Don't have an account ? "
                               FontSize="13"
                               TextColor="Gray"/>

                        <Label Text="Register"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#4facfe">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                            </Label.GestureRecognizers>

                        </Label>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>